# Datadog lane for the harness. Simplest setup:
#
#   1. cp .env.example .env
#   2. paste your two keys below (links show where to get them)
#   3. make demo
#
# No Datadog account? Skip this file entirely — the harness runs offline (Prometheus only).

# API key — https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=

# Application key — https://app.datadoghq.com/organization-settings/application-keys
DD_APP_KEY=

# Your site: look at your Datadog URL. app.datadoghq.com -> datadoghq.com (the default).
# EU users: datadoghq.eu. Only change if yours differs.
DD_SITE=datadoghq.com
